[Unit]
Description=HomeWizard P1 meter emulator (DSMR -> HomeWizard local API)
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/dsmr2homewizard
ExecStart=/usr/local/bin/dsmr2homewizard
# "Press the button": opens the API v2 pairing window.
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=5

DynamicUser=yes
StateDirectory=dsmr2homewizard
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyS rw

[Install]
WantedBy=multi-user.target
